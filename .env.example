# ---------------------------------------------------------------------------
# BizSakhi environment configuration
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ---------------------------------------------------------------------------

# Public base URL of this deployment (no trailing slash).
# Local: http://localhost:3000  Preview/Prod: https://your-domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase -------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxx.supabase.co (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key. Safe for the browser; RLS is what protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret (service-role) key. SERVER ONLY. Bypasses RLS - never expose it.
SUPABASE_SECRET_KEY=
# Direct Postgres connection string, used by the Supabase CLI for migrations.
SUPABASE_DB_URL=

# --- Stripe Billing -------------------------------------------------------
# Test-mode secret key (sk_test_...). SERVER ONLY.
STRIPE_SECRET_KEY=
# Signing secret from `stripe listen` or the dashboard webhook endpoint.
STRIPE_WEBHOOK_SECRET=
# Publishable key (pk_test_...).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Price IDs created in your own Stripe account (price_...).
STRIPE_STARTER_MONTHLY_PRICE_ID=
STRIPE_STARTER_ANNUAL_PRICE_ID=
STRIPE_GROWTH_MONTHLY_PRICE_ID=
STRIPE_GROWTH_ANNUAL_PRICE_ID=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=

# --- AI provider ----------------------------------------------------------
# anthropic | vercel-gateway | mock   (mock is for tests/CI only)
AI_PROVIDER=mock
# Model id, e.g. claude-sonnet-5 (anthropic) or anthropic/claude-sonnet-5 (gateway)
AI_MODEL=claude-sonnet-5
# Required when AI_PROVIDER=anthropic. SERVER ONLY.
ANTHROPIC_API_KEY=
# Required when AI_PROVIDER=vercel-gateway. SERVER ONLY.
AI_GATEWAY_API_KEY=

# --- Meta (WhatsApp Cloud API + Instagram Messaging) ----------------------
# Leave blank until a Meta app exists; the product shows "Setup required".
META_APP_ID=
META_APP_SECRET=
# Arbitrary string you also paste into the Meta webhook config.
META_VERIFY_TOKEN=
META_REDIRECT_URI=http://localhost:3000/api/meta/oauth/callback
# 32-byte key, base64 encoded. Generate: openssl rand -base64 32
INTEGRATION_ENCRYPTION_KEY=

# --- Cron -----------------------------------------------------------------
# Shared secret required by /api/cron/* endpoints. Generate: openssl rand -hex 32
CRON_SECRET=
